# ApplyPilot AI environment configuration.
# Phase 1 is fully local: no variables are required to build or test the extension.
# Never put secrets in variables prefixed with VITE_; Vite embeds those in the client bundle.

# Base URL of the ApplyPilot API (Phase 3+). Leave empty to run local-only.
VITE_API_BASE_URL=

# Server-side only (services/api, Phase 3+). Never referenced by the extension.
# ANTHROPIC_API_KEY=
