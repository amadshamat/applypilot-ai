{
  "name": "@applypilot/api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local ApplyPilot API: holds the Claude API key server-side and serves the extension's AI features.",
  "exports": {
    "./table": "./src/cloud/table.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "setup": "tsx src/setup.ts",
    "typecheck": "tsc -p tsconfig.json",
    "cloud:local": "tsx src/local/main.ts",
    "build:lambda": "node scripts/build-lambda.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@applypilot/ai-core": "workspace:*",
    "@applypilot/shared": "workspace:*",
    "@applypilot/sync": "workspace:*",
    "@applypilot/tracking": "workspace:*",
    "@aws-sdk/client-cognito-identity-provider": "3.1147.0",
    "@aws-sdk/client-dynamodb": "3.1147.0",
    "@aws-sdk/client-secrets-manager": "3.1147.0",
    "@aws-sdk/lib-dynamodb": "3.1147.0",
    "aws-jwt-verify": "5.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "dynalite": "4.0.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
